# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local dev virtualenv. .claude/launch.json points at .venv/bin/python by
# relative path, so no home directory ends up in a committed file.
#
# MAKE IT A SYMLINK, not a real directory. This project lives under
# ~/Documents, which is synced by iCloud Drive. A venv is ~7,500 files;
# creating one in place hands all of them to the sync daemon and stalls
# I/O across the whole folder — measured 27s to `import config` (at 0%
# CPU) versus 1.3s from a venv outside Documents. Same effect on Desktop.
#
#   python3 -m venv ~/.venvs/runsheet-pilot
#   ~/.venvs/runsheet-pilot/bin/python -m pip install -r requirements-dev.txt
#   ln -s ~/.venvs/runsheet-pilot .venv
#
# Not /tmp either: macOS deletes files there after ~3 days and leaves the
# bin/ symlinks behind, so the venv looks present and pytest is gone.
.venv/
.venv
venv/

# PyInstaller build artifacts
build/
dist/
*.spec
build_venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local user data (these live in the OS app-data dir, but just in case)
# settings.json holds the OpenRouter API key — must never be committed
settings.json
# ...but Claude Code's hook config is not that file. It holds only the
# commands in .claude/hooks/ and no secrets, and it has to be committed
# or the hooks vanish on a fresh clone. Machine-local permissions stay
# in .claude/settings.local.json, which the rule above still covers.
!.claude/settings.json
*.log

# Secrets / env files — defensive (not used today, but never commit if added later)
.env
.env.*
*.secret
secrets.json

# Licensing private key — NEVER commit. The Ed25519 private key signs paid
# Service Mate licence keys; if it leaks, anyone can mint free licences.
# Only the matching PUBLIC key is embedded (safely) in licensing.py.
tools/secrets/
*_private_key*
license_private*
*.pem

# Claude Code local permissions (project-personal)
.claude/settings.local.json

# graphify knowledge graph (local dev aid — regenerate with /graphify)
graphify-out/

# Claude Code project-context file — kept locally for Claude sessions only,
# deliberately NOT pushed to GitHub.
CLAUDE.md

# Sample runsheets — real church PDFs may contain volunteer names / PII
*.pdf
